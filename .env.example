# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
#
# ORG_READ_TOKEN: GitHub Personal Access Token (classic) with `public_repo` scope.
# Used by scripts/build_nav.py to authenticate GitHub API calls and avoid
# the unauthenticated rate limit (60 req/hr).
#
# Create a token at: https://github.com/settings/tokens
# Required scopes: public_repo (read access to public org repos)
#
ORG_READ_TOKEN=
# GH_TOKEN is also accepted by scripts/build_nav.py as a fallback auth token.

